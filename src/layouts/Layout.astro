---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Cortes TV' } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const swUrl = import.meta.env.PROD ? withBase('sw.js') : '';
const swScope = `${base.replace(/\/$/, '')}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Gestiona tus películas y series con un diseño Apple, Liquid Glass." />
    <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <!-- PWA / Añadir a inicio en iOS -->
    <link rel="manifest" href={withBase('manifest.webmanifest')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Cortes TV" />
    <link rel="apple-touch-icon" href={withBase('icons/icon-180.png')} />
    <link rel="icon" type="image/svg+xml" href={withBase('icons/icon.svg')} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('icons/icon-192.png')} />

    <title>{title}</title>

    <!-- Tema sin flash: aplica .dark antes del primer pintado -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('cortes-tv:theme') || 'system';
          const dark =
            t === 'dark' ||
            (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        } catch (_) {}
      })();
    </script>
    <!-- Offline support (public/sw.js); production only, so dev never serves stale files -->
    <script is:inline define:vars={{ swUrl, swScope }}>
      if (swUrl && 'serviceWorker' in navigator) {
        addEventListener('load', () => {
          navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(() => {});
        });
      }
    </script>
  </head>
  <body>
    <!-- Atmospheric background, so the glass chrome has colour to pick up -->
    <div class="atmosphere" aria-hidden="true"></div>

    <slot />
  </body>
</html>
